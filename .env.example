OUTSCRAPER_API_KEY=your_outscraper_key_here
# Optional fallback GHL defaults (used only if tenant headers are not sent)
GHL_PIT_TOKEN=
GHL_LOCATION_ID=
GHL_API_VERSION=2021-07-28

# GoHighLevel Marketplace OAuth
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_OAUTH_REDIRECT_URI=https://your-domain.com/oauth/ghl/callback
GHL_OAUTH_INSTALL_URL=
GHL_OAUTH_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token
GHL_OAUTH_USER_TYPE=Location
GHL_OAUTH_REQUIRE_STATE=true
GHL_OAUTH_STATE_TTL_SECONDS=900
GHL_OAUTH_STATE_SECRET=
GHL_OAUTH_SUCCESS_REDIRECT_URL=
GHL_OAUTH_ALLOW_TOKEN_RESPONSE_IN_PRODUCTION=false
GHL_INSTALL_STORE_PATH=/tmp/leadsmcp_ghl_installs.jsonl
# Optional override. If unset, falls back to GHL_OAUTH_STATE_SECRET then MCP_SECRET.
GHL_INSTALL_ENCRYPTION_SECRET=
# Marketplace AI provider options: google, groq, openai
LEADSMCP_MARKETPLACE_LLM_PROVIDER=google
# Google Gemini is a strong default for the embedded AI workspace.
GEMINI_API_KEY=AIza_your_gemini_key_here
# Groq remains available as a fallback provider.
GROQ_API_KEY=gsk_your_groq_key_here
# Optional fallback if you prefer OpenAI instead of Groq.
OPENAI_API_KEY=sk-your-key-here
# Defaults:
# - google -> gemini-2.5-flash
# - groq   -> openai/gpt-oss-20b
# - openai -> gpt-4o-mini
LEADSMCP_MARKETPLACE_LLM_MODEL=

# Required for securing the MCP endpoint (clients send as x-mcp-secret header)
MCP_SECRET=replace_with_a_long_random_secret

# Browser clients allowed to call this API (comma-separated, no spaces).
# In production, requests from other browser origins will be blocked by CORS.
CORS_ALLOWED_ORIGINS=https://your-app.example.com

# Stripe usage billing
STRIPE_SECRET_KEY=sk_live_or_test_key_here
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_METER_EVENT_NAME=qualified_lead_export
STRIPE_METER_VALUE_FIELD=leads_exported
STRIPE_METER_CUSTOMER_FIELD=stripe_customer_id
STRIPE_METERED_PRICE_ID=price_XXXXXXXXXXXX

# Qualified lead pricing + safeguards
# Pricing rule is full_name AND job_title AND (verified_email OR verified_phone)
QUALIFIED_LEAD_UNIT_PRICE_USD=1.20
QUALIFIED_LEAD_VERIFIED_EMAIL_STATUSES=valid,verified,receiving
QUALIFIED_LEAD_VERIFIED_PHONE_STATUSES=valid,verified,mobile,landline

# Billing consent mode:
# - per_batch (recommended): explicit user permission required per export batch
# - auto: no per-batch consent requirement once subscription access exists
BILLING_CONSENT_MODE=per_batch

# Require export batch IDs to prevent accidental duplicate billing.
BILLING_REQUIRE_EXPORT_BATCH_ID=true

# Verify active subscription access before posting meter events.
STRIPE_ENFORCE_EXPORT_ACCESS_CHECK=true

# Optional JSONL ledger path for local batch guard history.
EXPORT_BILLING_LEDGER_PATH=/tmp/leadsmcp_export_billing_ledger.jsonl
