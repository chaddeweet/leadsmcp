OUTSCRAPER_API_KEY=your_outscraper_key_here
# Optional fallback GHL defaults (used only if tenant headers are not sent)
GHL_PIT_TOKEN=
GHL_LOCATION_ID=
GHL_API_VERSION=2021-07-28
# HighLevel v2 catalog endpoint. Exposes search, fetch, search_operations,
# describe_operation, and execute_operation across all OAuth/PIT-granted scopes.
GHL_MCP_URL=https://services.leadconnectorhq.com/mcp/anthropic/v2

# Public deployments fail closed to the approved nine-tool Marketplace catalog.
# Use developer only in a controlled, non-customer deployment.
LEADSMCP_MODE=marketplace

# Optional legacy compatibility mode for LEADSMCP_MODE=developer.
GHL_V2_TOOL_ALLOWLIST_ENABLED=false
GHL_ENABLED_TOOL_GROUPS=contacts,opportunities,conversations,locations
GHL_ENABLED_TOOLS=
GHL_TOOL_ALLOWLIST_DISABLED=false

# GoHighLevel Marketplace OAuth
GHL_APP_ID=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_OAUTH_REDIRECT_URI=https://your-domain.com/oauth/ghl/callback
GHL_OAUTH_INSTALL_URL=
GHL_OAUTH_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token
GHL_OAUTH_API_VERSION=v3
# Optional override for a constrained deployment. Leave blank so HighLevel
# determines Company versus Location from the actual installation.
GHL_OAUTH_USER_TYPE=
GHL_OAUTH_REQUIRE_STATE=true
GHL_OAUTH_STATE_TTL_SECONDS=900
GHL_OAUTH_STATE_SECRET=
GHL_OAUTH_SUCCESS_REDIRECT_URL=
# Never echo OAuth tokens from callbacks unless explicitly debugging locally.
GHL_OAUTH_ALLOW_TOKEN_RESPONSE=false
# Deprecated compatibility name; prefer GHL_OAUTH_ALLOW_TOKEN_RESPONSE.
GHL_OAUTH_ALLOW_TOKEN_RESPONSE_IN_PRODUCTION=false
# Marketplace/production must use Supabase. File storage is developer-only.
GHL_INSTALL_STORE_BACKEND=supabase
SUPABASE_GHL_INSTALLS_TABLE=ghl_installations
GHL_INSTALL_STORE_PATH=/tmp/leadsmcp_ghl_installs.jsonl
# Optional override. If unset, falls back to GHL_OAUTH_STATE_SECRET then MCP_SECRET.
GHL_INSTALL_ENCRYPTION_SECRET=
# Current HighLevel Ed25519 webhook verification is enabled at /webhooks/ghl.
# Override only if HighLevel rotates its documented public key.
GHL_WEBHOOK_ED25519_PUBLIC_KEY=
# Native Marketplace Wallet Charges meter ID from the app pricing page.
GHL_MARKETPLACE_METER_ID=
# Required for securing the MCP endpoint (clients send as x-mcp-secret header)
MCP_SECRET=replace_with_a_long_random_secret

# Browser clients allowed to call this API (comma-separated, no spaces).
# In production, requests from other browser origins will be blocked by CORS.
CORS_ALLOWED_ORIGINS=https://your-app.example.com

# Stripe usage billing
STRIPE_SECRET_KEY=sk_live_or_test_key_here
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_METER_EVENT_NAME=qualified_lead_export
STRIPE_METER_VALUE_FIELD=leads_exported
STRIPE_METER_CUSTOMER_FIELD=stripe_customer_id
STRIPE_METERED_PRICE_ID=price_XXXXXXXXXXXX

# Qualified lead pricing + safeguards
# Pricing rule is full_name AND job_title AND (verified_email OR verified_phone)
QUALIFIED_LEAD_UNIT_PRICE_USD=1.20
QUALIFIED_LEAD_VERIFIED_EMAIL_STATUSES=valid,verified,receiving
QUALIFIED_LEAD_VERIFIED_PHONE_STATUSES=valid,verified,mobile,landline

# Billing consent mode:
# - per_batch (recommended): explicit user permission required per export batch
# - auto: no per-batch consent requirement once subscription access exists
BILLING_CONSENT_MODE=per_batch

# Require export batch IDs to prevent accidental duplicate billing.
BILLING_REQUIRE_EXPORT_BATCH_ID=true

# Verify active subscription access before posting meter events.
STRIPE_ENFORCE_EXPORT_ACCESS_CHECK=true

# Optional JSONL ledger path for local batch guard history.
EXPORT_BILLING_LEDGER_PATH=/tmp/leadsmcp_export_billing_ledger.jsonl

# Optional canonical base URL used for OAuth callbacks and public links.
# PUBLIC_BASE_URL=https://mcp.chaddewet.com

# ── Custom Connector OAuth 2.0 / DCR (ChatGPT, Perplexity) ────────────────────
# Supabase persists authorization codes and access/refresh tokens across the
# serverless invocations that handle /authorize, /token, and /mcp. Without it the
# flow breaks on Vercel because /tmp is not shared between invocations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional table name override (default: connector_oauth).
SUPABASE_OAUTH_TABLE=connector_oauth
# Force-enable the OAuth surface. Auto-enables when SUPABASE_* or CONNECTOR_CLIENTS
# are set; leave blank to keep that default.
CONNECTOR_OAUTH_ENABLED=
# Allow RFC 7591 Dynamic Client Registration at /register (default true).
CONNECTOR_DCR_ENABLED=true
# Token lifetimes (seconds).
CONNECTOR_TOKEN_TTL=3600
CONNECTOR_REFRESH_TTL=2592000
# Space-separated OAuth scopes advertised in discovery (default: mcp).
CONNECTOR_SCOPES_SUPPORTED=mcp
# Optional legacy static clients (confidential). DCR is preferred.
# CONNECTOR_CLIENTS={"chatgpt":{"secret":"...","name":"ChatGPT","redirect_uris":["https://chatgpt.com/aip/..."]}}
# Optional manifest contact email surfaced at /.well-known/mcp.json.
LEADSMCP_CONTACT_EMAIL=

# ── TempMail.so (disposable inboxes for outreach) ─────────────────────────────
# TWO DISTINCT CREDENTIALS ARE REQUIRED — they are not the same value.
# 1) RapidAPI key from https://rapidapi.com (subscribe to tempmail-so).
TEMPMAIL_RAPIDAPI_KEY=
# 2) TempMail.so account bearer token from
#    https://tempmail.so/mailboxes -> Account -> Account Information.
#    Without this, every call returns HTTP 403 "Invalid Login Credential" (code 257).
TEMPMAIL_AUTH_TOKEN=
# Per-tenant override headers (take precedence over the env vars above):
#   x-tempmail-rapidapi-key: <rapidapi key>
#   x-tempmail-token: <tempmail.so account token>
